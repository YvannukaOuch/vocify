# Copy to server/.env and fill in.

# Required: the token @BotFather gave you.
BOT_TOKEN=

# Public HTTPS address of this server. Telegram opens the Mini App from here.
# On the VPS: your domain behind Caddy. On your PC: a cloudflared tunnel URL.
WEBAPP_URL=https://soundboard.example.com

# Telegram user IDs allowed to use the bot, comma-separated. Empty = anyone who finds it.
# Send /start to the bot and check the server log for "from user <id>".
ALLOWED_USER_IDS=

# --- Optional ---------------------------------------------------------------

# PORT=3000
# HOST=127.0.0.1
# DB_PATH=data/voicify.db
# MAX_CLIP_SECONDS=60
# MAX_CONCURRENT_JOBS=1

# Paths to the tools, if they aren't on PATH.
# YTDLP_PATH=yt-dlp
# FFMPEG_PATH=ffmpeg

# Extra yt-dlp flags. If YouTube starts answering "Sign in to confirm you're not a bot",
# export cookies.txt from a throwaway YouTube account and add:
# YTDLP_EXTRA_ARGS=--cookies data/cookies.txt

# Dev only (ignored when NODE_ENV=production): lets a normal browser use the API as this user.
# DEV_USER_ID=
